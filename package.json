{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "argus",
  "version": "1.7.0",
  "description": "Quietly powerful exam and visual AI assistant Chrome extension",
  "main": "src/background.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
